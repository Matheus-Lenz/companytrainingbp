        <name>EnrollmentScheduleFilter</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var EnrollmentScheduleFilter = Class.create();
EnrollmentScheduleFilter.prototype = {
    initialize: function() {},

    getSchedulesForTraining: function(current) {
        var trainingId = '';

        try {
            if (current.training)
                trainingId = current.training.toString();
            else if (current.variables && current.variables.training)
                trainingId = current.variables.training.toString();
        } catch (e) {
            gs.info('[EnrollmentScheduleFilter] Falha ao recuperar training: ' + e.message);
        }

        if (!trainingId)
            return 'sys_idISEMPTY';

        return 'training=' + trainingId;
    },

    type: 'EnrollmentScheduleFilter'
};]]></script>
