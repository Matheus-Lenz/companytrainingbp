        <name>ValidateTrainingSchedule</name>
        <sandbox_callable>false</sandbox_callable>
        <script><![CDATA[var ValidateTrainingSchedule = Class.create();
ValidateTrainingSchedule.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
	validateDate: function() {
		var course = this.getParameter("sysparm_course");
		var date = this.getParameter("sysparm_date");
		if(!course || !date){
			return "true";
		}

		var gr = new GlideRecord("x_1805892_compan_0_schedule");
		gr.addQuery("training", course);
		gr.addQuery("schedule_for", date);
		//gr.setLimit(1);
		gr.query();
		
		if(gr.hasNext()) {
		return "true";
		}
		return "false";
	},

    type: 'ValidateTrainingSchedule'
});]]></script>
